<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/base.xml"/>

    <springProperty scope="context" name="logstashHost" source="app.logstash.host" defaultValue="logstash"/>
    <springProperty scope="context" name="logstashPort" source="app.logstash.port" defaultValue="5000"/>
    <springProperty scope="context" name="serviceName" source="spring.application.name" defaultValue="service"/>

    <!-- Единый JSON-паттерн сообщений для всех сервисов (Microservice Chassis):
         одинаковая структура лога — @timestamp, @version, message, logger_name, thread_name,
         level, service_name, trace_id, span_id, mdc, stack_trace. -->
    <appender name="LOGSTASH_TCP" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>${logstashHost}:${logstashPort}</destination>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <timeZone>UTC</timeZone>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</pattern>
                </timestamp>
                <version/>
                <message/>
                <loggerName>
                    <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
                </loggerName>
                <threadName/>
                <logLevel/>
                <mdc>
                    <excludeMdcKeyName>traceId</excludeMdcKeyName>
                    <excludeMdcKeyName>spanId</excludeMdcKeyName>
                </mdc>
                <pattern>
                    <omitEmptyFields>true</omitEmptyFields>
                    <pattern>
                        {
                            "service_name": "${serviceName}",
                            "trace_id": "%X{traceId:-}",
                            "span_id": "%X{spanId:-}"
                        }
                    </pattern>
                </pattern>
                <stackTrace/>
            </providers>
        </encoder>
        <keepAliveDuration>1 minute</keepAliveDuration>
    </appender>

    <!-- Async + neverBlock: приложение не блокируется и не падает, если Logstash недоступен. -->
    <appender name="LOGSTASH_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="LOGSTASH_TCP"/>
    </appender>

    <!-- Уровни: error/warn/info логируются в корне; debug-диагностика кода сервисов ниже. -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOGSTASH_ASYNC"/>
    </root>

    <!-- Диагностическая информация (debug) для прикладного кода; системные пакеты остаются на INFO. -->
    <logger name="ru.yandex.practicum" level="DEBUG"/>
</configuration>